color2  = #006d3c # base0B - Green
color3  = #9b6400 # base0A - Yellow
color4  = #2765b0 # base0D - Blue
color5  = #524663 # base0E - Magenta
color6  = #006d80 # base0C - Cyan
color7  = #302a3b # base05 - White
color8  = #d4d3da # base03 - Bright Black
color9  = #5f171e # base12 - Bright Red
color10 = #00572e # base14 - Bright Green
color11 = #815200 # base13 - Bright Yellow
color12 = #165196 # base16 - Bright Blue
color13 = #803569 # base17 - Bright Magenta
color14 = #005867 # base15 - Bright Cyan
color15 = #302a3b # base07 - Bright White
color16 = #a04f19 # base09
color17 = #9a4580 # base0F
color18 = #f0eff6 # base01
color19 = #e5e3ea # base02
color20 = #86858b # base04
color21 = #48474c # base06
