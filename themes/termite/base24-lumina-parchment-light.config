color6  = #006476 # base0C - Cyan
color7  = #302416 # base05 - White
color8  = #cdc7b9 # base03 - Bright Black
color9  = #5c1d1b # base12 - Bright Red
color10 = #003520 # base14 - Bright Green
color11 = #764a00 # base13 - Bright Yellow
color12 = #17467e # base16 - Bright Blue
color13 = #642955 # base17 - Bright Magenta
color14 = #004f5e # base15 - Bright Cyan
color15 = #302416 # base07 - Bright White
