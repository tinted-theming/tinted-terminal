color6  = #bedee4 # base0C - Cyan
color7  = #cfdceb # base05 - White
color8  = #223755 # base03 - Bright Black
color9  = #e88f86 # base12 - Bright Red
color10 = #a1f2ce # base14 - Bright Green
color11 = #fbea87 # base13 - Bright Yellow
color12 = #b1deff # base16 - Bright Blue
color13 = #ffc5f8 # base17 - Bright Magenta
color14 = #b8f4ff # base15 - Bright Cyan
color15 = #cfdceb # base07 - Bright White
