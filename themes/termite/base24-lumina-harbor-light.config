color4  = #2863ab # base0D - Blue
color5  = #7f5bb6 # base0E - Magenta
color6  = #006f82 # base0C - Cyan
color7  = #1b2737 # base05 - White
color8  = #c4cfdb # base03 - Bright Black
color9  = #712a26 # base12 - Bright Red
color10 = #086035 # base14 - Bright Green
color11 = #884806 # base13 - Bright Yellow
color12 = #1e508b # base16 - Bright Blue
color13 = #70366c # base17 - Bright Magenta
color14 = #005969 # base15 - Bright Cyan
color15 = #1b2737 # base07 - Bright White
color16 = #a55800 # base09
color17 = #874882 # base0F
color18 = #e0ebf7 # base01
