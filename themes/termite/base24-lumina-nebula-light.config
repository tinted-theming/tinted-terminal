[colors]
# base24 Lumina Nebula Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #1f2a38
foreground_bold     = #1f2a38
cursor              = #1f2a38
cursor_foreground   = #f6f8fb
background          = #f6f8fb

color0  = #f6f8fb # base00 - Black
color1  = #902725 # base08 - Red
color2  = #2e7241 # base0B - Green
color3  = #996000 # base0A - Yellow
color4  = #34639e # base0D - Blue
color5  = #6c4d9e # base0E - Magenta
color6  = #00657e # base0C - Cyan
color7  = #1f2a38 # base05 - White
color8  = #d3d5da # base03 - Bright Black
color9  = #692623 # base12 - Bright Red
color10 = #1a5d2f # base14 - Bright Green
color11 = #7e4e00 # base13 - Bright Yellow
color12 = #214f88 # base16 - Bright Blue
color13 = #6e3569 # base17 - Bright Magenta
color14 = #005064 # base15 - Bright Cyan
color15 = #1f2a38 # base07 - Bright White
color16 = #944d1f # base09
color17 = #84487f # base0F
color18 = #eff1f6 # base01
color19 = #e3e6ea # base02
color20 = #84868a # base04
color21 = #46484b # base06
