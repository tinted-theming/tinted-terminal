color6  = #037393 # base0C - Cyan
color7  = #404246 # base05 - White
color8  = #d3d4d6 # base03 - Bright Black
color9  = #601e1c # base12 - Bright Red
color10 = #0f693e # base14 - Bright Green
color11 = #874e00 # base13 - Bright Yellow
color12 = #21528e # base16 - Bright Blue
color13 = #7e3861 # base17 - Bright Magenta
color14 = #005e79 # base15 - Bright Cyan
color15 = #404246 # base07 - Bright White
color16 = #9f420b # base09
color17 = #a7367b # base0F
color18 = #eff0f2 # base01
