color5  = #5c4c9a # base0E - Magenta
color6  = #28596c # base0C - Cyan
color7  = #322219 # base05 - White
color8  = #d6ccc0 # base03 - Bright Black
color9  = #974043 # base12 - Bright Red
color10 = #065826 # base14 - Bright Green
color11 = #834a00 # base13 - Bright Yellow
color12 = #005381 # base16 - Bright Blue
color13 = #6a2c65 # base17 - Bright Magenta
color14 = #00465c # base15 - Bright Cyan
color15 = #322219 # base07 - Bright White
color16 = #6f3000 # base09
color17 = #803f7b # base0F
color18 = #f2e8dc # base01
color19 = #e7dcd0 # base02
