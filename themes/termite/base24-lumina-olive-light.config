color6  = #006b7d # base0C - Cyan
color7  = #262816 # base05 - White
color8  = #cecdbe # base03 - Bright Black
color9  = #601e1c # base12 - Bright Red
color10 = #145b2b # base14 - Bright Green
color11 = #7b4c00 # base13 - Bright Yellow
color12 = #244886 # base16 - Bright Blue
color13 = #6d3268 # base17 - Bright Magenta
color14 = #005664 # base15 - Bright Cyan
color15 = #262816 # base07 - Bright White
