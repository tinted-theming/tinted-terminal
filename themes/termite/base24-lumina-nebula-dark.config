color4  = #92bef8 # base0D - Blue
color5  = #aaaaec # base0E - Magenta
color6  = #00dfe5 # base0C - Cyan
color7  = #cadceb # base05 - White
color8  = #202833 # base03 - Bright Black
color9  = #df847d # base12 - Bright Red
color10 = #a3e9b2 # base14 - Bright Green
color11 = #ffe6a0 # base13 - Bright Yellow
color12 = #bad7ff # base16 - Bright Blue
color13 = #ffbbf7 # base17 - Bright Magenta
color14 = #8ff1f4 # base15 - Bright Cyan
color15 = #cadceb # base07 - Bright White
color16 = #ddc6b0 # base09
