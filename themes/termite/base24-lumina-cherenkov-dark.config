color7  = #d0dce9 # base05 - White
color8  = #20283a # base03 - Bright Black
color9  = #e5867e # base12 - Bright Red
color10 = #a4edb2 # base14 - Bright Green
color11 = #fcd36b # base13 - Bright Yellow
color12 = #d3ecff # base16 - Bright Blue
color13 = #ffbff8 # base17 - Bright Magenta
color14 = #84eaf6 # base15 - Bright Cyan
