color3  = #a35f00 # base0A - Yellow
color4  = #2c516b # base0D - Blue
color5  = #4433aa # base0E - Magenta
color6  = #00697b # base0C - Cyan
color7  = #1e2735 # base05 - White
color8  = #ced6db # base03 - Bright Black
color9  = #9e423d # base12 - Bright Red
color10 = #3b671b # base14 - Bright Green
color11 = #874e00 # base13 - Bright Yellow
color12 = #003e60 # base16 - Bright Blue
color13 = #6d347a # base17 - Bright Magenta
color14 = #005462 # base15 - Bright Cyan
color15 = #1e2735 # base07 - Bright White
color16 = #95470f # base09
color17 = #814a8d # base0F
color18 = #e9f2f7 # base01
color19 = #dee6ec # base02
color20 = #80878c # base04
