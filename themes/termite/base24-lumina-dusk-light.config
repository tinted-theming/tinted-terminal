color3  = #644c31 # base0A - Yellow
color4  = #334f9d # base0D - Blue
color5  = #5a4d91 # base0E - Magenta
color6  = #006576 # base0C - Cyan
color7  = #3f3341 # base05 - White
color8  = #d0c7d2 # base03 - Bright Black
color9  = #622220 # base12 - Bright Red
color10 = #125529 # base14 - Bright Green
color11 = #593500 # base13 - Bright Yellow
color12 = #283e7a # base16 - Bright Blue
color13 = #532559 # base17 - Bright Magenta
color14 = #00505e # base15 - Bright Cyan
color15 = #3f3341 # base07 - Bright White
color16 = #944e20 # base09
color17 = #6f2c79 # base0F
color18 = #ece2ee # base01
color19 = #e1d7e2 # base02
