[colors]
# base24 Lumina Canopy Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #cddbd0
foreground_bold     = #cddbd0
cursor              = #cddbd0
cursor_foreground   = #131d16
background          = #131d16

color0  = #131d16 # base00 - Black
color1  = #d3665e # base08 - Red
color2  = #96d4a2 # base0B - Green
color3  = #f2bb31 # base0A - Yellow
color4  = #8dc6ff # base0D - Blue
color5  = #c1b8fc # base0E - Magenta
color6  = #8ce3dd # base0C - Cyan
color7  = #cddbd0 # base05 - White
color8  = #2a362d # base03 - Bright Black
color9  = #df8981 # base12 - Bright Red
color10 = #aeefbb # base14 - Bright Green
color11 = #ffd989 # base13 - Bright Yellow
color12 = #bedeff # base16 - Bright Blue
color13 = #f2b9f5 # base17 - Bright Magenta
color14 = #a1fbf5 # base15 - Bright Cyan
color15 = #cddbd0 # base07 - Bright White
color16 = #fdad76 # base09
color17 = #d1a5d3 # base0F
color18 = #17221a # base01
color19 = #202c24 # base02
color20 = #617064 # base04
color21 = #abb4ad # base06
