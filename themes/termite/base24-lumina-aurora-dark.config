color6  = #75d7e2 # base0C - Cyan
color7  = #d9d5e3 # base05 - White
color8  = #292336 # base03 - Bright Black
color9  = #e0847c # base12 - Bright Red
color10 = #a2f4c4 # base14 - Bright Green
color11 = #ffe4b7 # base13 - Bright Yellow
color12 = #d2dfff # base16 - Bright Blue
color13 = #ffcbf9 # base17 - Bright Magenta
color14 = #8ef2fd # base15 - Bright Cyan
color15 = #d9d5e3 # base07 - Bright White
