[colors]
# base24 Lumina Espresso Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #e5dbcd
foreground_bold     = #e5dbcd
cursor              = #e5dbcd
cursor_foreground   = #2f1d11
background          = #2f1d11

color0  = #2f1d11 # base00 - Black
color1  = #d47169 # base08 - Red
color2  = #92c79c # base0B - Green
color3  = #fdcf90 # base0A - Yellow
color4  = #92bbea # base0D - Blue
color5  = #b6afe8 # base0E - Magenta
color6  = #b7dce5 # base0C - Cyan
color7  = #e5dbcd # base05 - White
color8  = #4b3527 # base03 - Bright Black
color9  = #e1938b # base12 - Bright Red
color10 = #aae1b5 # base14 - Bright Green
color11 = #ffe3be # base13 - Bright Yellow
color12 = #b0d5ff # base16 - Bright Blue
color13 = #efadd2 # base17 - Bright Magenta
color14 = #bef2ff # base15 - Bright Cyan
color15 = #e5dbcd # base07 - Bright White
color16 = #ffbe92 # base09
color17 = #dc8ebb # base0F
color18 = #352114 # base01
color19 = #402b1d # base02
color20 = #866e5c # base04
color21 = #beada3 # base06
