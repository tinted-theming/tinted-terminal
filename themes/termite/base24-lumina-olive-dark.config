color2  = #9acca4 # base0B - Green
color3  = #edba7a # base0A - Yellow
color4  = #8fb9f7 # base0D - Blue
color5  = #baa5dd # base0E - Magenta
color6  = #8acbd2 # base0C - Cyan
color7  = #dfddce # base05 - White
color8  = #3a3c27 # base03 - Bright Black
color9  = #da9090 # base12 - Bright Red
color10 = #b2e7bd # base14 - Bright Green
color11 = #ffd7a6 # base13 - Bright Yellow
color12 = #b5d3ff # base16 - Bright Blue
color13 = #f8c4f3 # base17 - Bright Magenta
color14 = #a2e5ed # base15 - Bright Cyan
color15 = #dfddce # base07 - Bright White
color16 = #e18c5f # base09
color17 = #ddabd8 # base0F
color18 = #262814 # base01
color19 = #30321d # base02
color20 = #6f755c # base04
color21 = #b1b3a3 # base06
