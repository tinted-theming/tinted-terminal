[colors]
# base24 Lumina Olive Dark
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #dfddce
foreground_bold     = #dfddce
cursor              = #dfddce
cursor_foreground   = #212311
background          = #212311

color0  = #212311 # base00 - Black
