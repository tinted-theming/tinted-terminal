color3  = #ddbb67 # base0A - Yellow
color4  = #9cc2f4 # base0D - Blue
color5  = #b296ff # base0E - Magenta
color6  = #95e0e8 # base0C - Cyan
color7  = #cdd0d4 # base05 - White
color8  = #323334 # base03 - Bright Black
color9  = #e59189 # base12 - Bright Red
color10 = #cbf8b6 # base14 - Bright Green
color11 = #f9d57d # base13 - Bright Yellow
color12 = #c0dbff # base16 - Bright Blue
color13 = #fec2f8 # base17 - Bright Magenta
color14 = #acf7ff # base15 - Bright Cyan
color15 = #cdd0d4 # base07 - Bright White
