[colors]
# base24 Lumina Lagoon Light
# Scheme author: Razik Ikhlef (https://github.com/RazikSF)
# Template author: Tinted Theming (https://github.com/tinted-theming/tinted-termite)

foreground          = #212829
foreground_bold     = #212829
cursor              = #212829
cursor_foreground   = #eef9fb
background          = #eef9fb

color0  = #eef9fb # base00 - Black
color1  = #901f1f # base08 - Red
color2  = #007853 # base0B - Green
color3  = #a06200 # base0A - Yellow
color4  = #1e69a2 # base0D - Blue
color5  = #5f3fa9 # base0E - Magenta
color6  = #345a61 # base0C - Cyan
color7  = #212829 # base05 - White
color8  = #c8d7da # base03 - Bright Black
color9  = #69221e # base12 - Bright Red
color10 = #006143 # base14 - Bright Green
color11 = #855100 # base13 - Bright Yellow
color12 = #00558b # base16 - Bright Blue
color13 = #73356f # base17 - Bright Magenta
color14 = #004953 # base15 - Bright Cyan
color15 = #212829 # base07 - Bright White
color16 = #9e501d # base09
color17 = #8a4885 # base0F
color18 = #e4f3f6 # base01
color19 = #d8e8ea # base02
color20 = #7b898c # base04
color21 = #3e4a4d # base06
