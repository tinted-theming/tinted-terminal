color4  = #0555b7 # base0D - Blue
color5  = #693d9c # base0E - Magenta
color6  = #005c71 # base0C - Cyan
color7  = #1d2638 # base05 - White
color8  = #d3d9dd # base03 - Bright Black
color9  = #6b1d1b # base12 - Bright Red
color10 = #005f28 # base14 - Bright Green
color11 = #815200 # base13 - Bright Yellow
color12 = #0a4490 # base16 - Bright Blue
color13 = #81326b # base17 - Bright Magenta
color14 = #004758 # base15 - Bright Cyan
color15 = #1d2638 # base07 - Bright White
