# Lumina Rayleigh Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #14182c
Red         = #da6d65
Green       = #96d2a1
Yellow      = #f8c970
Blue        = #7cbdff
Magenta     = #b897f0
Cyan        = #acdae6
White       = #d4dbea
BoldBlack   = #2b3048
BoldRed     = #e69088
BoldGreen   = #afedba
BoldYellow  = #ffe4b4
BoldBlue    = #aed6ff
BoldMagenta = #ffbee2
BoldCyan    = #bff2ff
BoldWhite   = #d4dbea

# Background & foreground colors
BackgroundColour = #14182c
ForegroundColour = #d4dbea
CursorColour     = #d4dbea
