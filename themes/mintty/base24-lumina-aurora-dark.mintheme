# Lumina Aurora Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #120c1c
Red         = #d45f58
Green       = #53e39c
Yellow      = #fecc74
Blue        = #b8c5e4
Magenta     = #c3bbff
Cyan        = #75d7e2
White       = #d9d5e3
BoldBlack   = #292336
BoldRed     = #e0847c
BoldGreen   = #a2f4c4
BoldYellow  = #ffe4b7
BoldBlue    = #d2dfff
BoldMagenta = #ffcbf9
BoldCyan    = #8ef2fd
BoldWhite   = #d9d5e3

# Background & foreground colors
BackgroundColour = #120c1c
ForegroundColour = #d9d5e3
CursorColour     = #d9d5e3
