Magenta     = #594c92
Cyan        = #006476
White       = #302416
BoldBlack   = #cdc7b9
BoldRed     = #5c1d1b
BoldGreen   = #003520
BoldYellow  = #764a00
BoldBlue    = #17467e
BoldMagenta = #642955
BoldCyan    = #004f5e
BoldWhite   = #302416

# Background & foreground colors
BackgroundColour = #f3e9d2
ForegroundColour = #302416
CursorColour     = #302416
