Blue        = #8fb9f7
Magenta     = #baa5dd
Cyan        = #8acbd2
White       = #dfddce
BoldBlack   = #3a3c27
BoldRed     = #da9090
BoldGreen   = #b2e7bd
BoldYellow  = #ffd7a6
BoldBlue    = #b5d3ff
BoldMagenta = #f8c4f3
BoldCyan    = #a2e5ed
BoldWhite   = #dfddce

# Background & foreground colors
BackgroundColour = #212311
ForegroundColour = #dfddce
CursorColour     = #dfddce
