# Lumina Nebula Light theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #f6f8fb
Red         = #902725
Green       = #2e7241
Yellow      = #996000
Blue        = #34639e
Magenta     = #6c4d9e
Cyan        = #00657e
White       = #1f2a38
BoldBlack   = #d3d5da
BoldRed     = #692623
BoldGreen   = #1a5d2f
BoldYellow  = #7e4e00
BoldBlue    = #214f88
BoldMagenta = #6e3569
BoldCyan    = #005064
BoldWhite   = #1f2a38

# Background & foreground colors
BackgroundColour = #f6f8fb
ForegroundColour = #1f2a38
CursorColour     = #1f2a38
