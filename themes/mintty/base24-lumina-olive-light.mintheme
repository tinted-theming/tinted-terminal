Magenta     = #644d87
Cyan        = #006b7d
White       = #262816
BoldBlack   = #cecdbe
BoldRed     = #601e1c
BoldGreen   = #145b2b
BoldYellow  = #7b4c00
BoldBlue    = #244886
BoldMagenta = #6d3268
BoldCyan    = #005664
BoldWhite   = #262816

# Background & foreground colors
BackgroundColour = #f1f0d9
ForegroundColour = #262816
