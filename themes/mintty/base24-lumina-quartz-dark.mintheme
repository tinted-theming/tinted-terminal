# Lumina Quartz Dark theme for Mintty
# Scheme Author: Razik Ikhlef (https://github.com/RazikSF)
# Scheme System: base24
# Template Author: Tinted Terminal (https://github.com/tinted-theming/tinted-terminal)

# The 16 color palette
Black       = #1a1b1c
Red         = #d96e66
Green       = #b9daaa
Yellow      = #ddbb67
Blue        = #9cc2f4
Magenta     = #b296ff
Cyan        = #95e0e8
White       = #cdd0d4
BoldBlack   = #323334
BoldRed     = #e59189
BoldGreen   = #cbf8b6
BoldYellow  = #f9d57d
BoldBlue    = #c0dbff
BoldMagenta = #fec2f8
BoldCyan    = #acf7ff
BoldWhite   = #cdd0d4

# Background & foreground colors
BackgroundColour = #1a1b1c
ForegroundColour = #cdd0d4
CursorColour     = #cdd0d4
