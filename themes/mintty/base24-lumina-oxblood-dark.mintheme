Cyan        = #00bed0
White       = #e4d2d7
BoldBlack   = #3d2f33
BoldRed     = #e98e86
BoldGreen   = #98e1b1
BoldYellow  = #ffe4b8
BoldBlue    = #c0dcff
BoldMagenta = #f2d5ff
