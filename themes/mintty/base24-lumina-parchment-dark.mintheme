Cyan        = #89c7ce
White       = #eee7d9
BoldBlack   = #4f4739
BoldRed     = #e89e97
BoldGreen   = #c4f7cd
BoldYellow  = #ffe4b3
BoldBlue    = #b8d7ff
BoldMagenta = #ecb6e0
BoldCyan    = #a1e1e8
BoldWhite   = #eee7d9

# Background & foreground colors
BackgroundColour = #342d21
ForegroundColour = #eee7d9
